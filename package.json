{
  "name": "claudecode-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "anthropics/claude-code workspace with local web UI (frontend only)",
  "scripts": {
    "bridge": "MCP_STARTUP_HEALTH=delayed node --import ./scripts/ensure-dev-native-preload.mjs server/index.mjs",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev:electron",
    "web:build": "npm --prefix web run build:electron",
    "web:lint": "npm --prefix web run lint",
    "postinstall": "node scripts/fix-node-pty-perms.mjs && node scripts/fix-vendor-native-modules.mjs",
    "web:dev:full": "CLAUDE_ORCHESTRATOR_SKIP_ELECTRON=1 node desktop/run-dev.mjs",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=\"${PLAYWRIGHT_BROWSERS_PATH:-$PWD/.playwright-browsers}\" npx playwright install chromium",
    "desktop:install": "npm --prefix desktop install",
    "desktop:dev": "node desktop/run-dev.mjs",
    "desktop": "npm run desktop:dev",
    "desktop:pack": "node scripts/pack-desktop.mjs",
    "vendor:install": "npm --prefix server/vendor/cad install --omit=dev && npm --prefix server/vendor/agent-os-runtime install --omit=dev && node scripts/fix-vendor-native-modules.mjs && node scripts/sync-vendor-tool-protocol.mjs",
    "vendor:sync-tool-protocol": "node scripts/sync-vendor-tool-protocol.mjs",
    "sync:cc-switch": "bash scripts/sync-cc-switch-to-workbench.sh",
    "setup:yunmeng": "bash scripts/setup-yunmeng-cc-switch.sh",
    "mcp:sqlite:ensure": "node scripts/ensure-mcp-sqlite.mjs",
    "mcp:npx:ensure": "node scripts/ensure-mcp-npx.mjs",
    "mcp:fetch:ensure": "node scripts/ensure-mcp-fetch.mjs",
    "mcp:ensure": "node scripts/ensure-mcp-sqlite.mjs && node scripts/ensure-mcp-npx.mjs && node scripts/ensure-mcp-fetch.mjs",
    "eval:agent": "node scripts/eval-agent-suite.mjs",
    "workspace:undo": "node scripts/workspace-undo.mjs",
    "check:agent-eval": "node scripts/eval-agent-suite.mjs --dry-run",
    "check:agent-adapters": "node scripts/check-agent-adapters.mjs",
    "check:model-capability-cache": "node scripts/check-model-capability-cache.mjs",
    "check:tool-call-protocol": "node scripts/check-tool-call-protocol.mjs",
    "check:stream-parsers": "node scripts/check-stream-parsers.mjs",
    "check:host-retry-cancel": "node scripts/check-host-retry-cancel.mjs",
    "check:host-live-cancel": "node scripts/check-host-live-cancel.mjs",
    "check:explicit-agent-cancel": "node scripts/check-explicit-agent-cancel.mjs",
    "check:workspace-command-cancel": "node scripts/check-workspace-command-cancel.mjs",
    "check:host-ollama-recovery": "node scripts/check-host-ollama-history-recovery.mjs",
    "check:host-prewrite-progress": "node scripts/check-host-prewrite-progress.mjs",
    "check:host-auto-continue": "node scripts/check-host-auto-continue.mjs",
    "check:general-agent-route": "node scripts/check-general-agent-route.mjs",
    "check:host-read-pagination": "node scripts/check-host-read-pagination.mjs",
    "check:host-verification-closure": "node scripts/check-host-verification-closure.mjs",
    "check:edit-engine": "node scripts/check-edit-engine.mjs",
    "check:host-mcp-runtime": "node scripts/check-host-mcp-runtime.mjs",
    "check:host-mcp-reuse": "node scripts/check-host-mcp-reuse.mjs",
    "check:host-edit-fallback": "node scripts/check-host-edit-fallback.mjs",
    "check:host-file-tools": "node scripts/check-host-file-tools.mjs",
    "check:workspace-test-detection": "node scripts/check-workspace-test-detection.mjs",
    "check:turn-observability": "node scripts/check-turn-observability.mjs",
    "check:repository-map": "node scripts/check-repository-map.mjs",
    "check:diff-hunks": "node --test web/src/lib/apply-unified-diff-hunks.test.mjs web/src/lib/apply-unified-diff.test.mjs",
    "check:agent-guardrails": "node scripts/check-agent-guardrails.mjs",
    "check:project-rules": "node --test web/src/lib/project-rules.test.mjs",
    "check:agent-retry-actions": "node scripts/check-agent-retry-actions.mjs && node --test web/src/lib/agent-failure-hint.test.mjs",
    "check:ollama-stream": "node scripts/check-ollama-stream-lossless.mjs",

    "check:turn-policy": "node scripts/check-turn-policy.mjs",
    "check:interrupted-agent-turn": "node scripts/check-interrupted-agent-turn.mjs",
    "check:project-data-path": "node scripts/check-project-data-path.mjs",
    "check:rpc-proxy-lifecycle": "node scripts/check-rpc-proxy-lifecycle.mjs",
    "check:workspace-fidelity": "node scripts/check-workspace-fidelity.mjs",
    "check:context-compact": "node scripts/check-context-compact.mjs",
    "check:model-route": "node scripts/check-model-route.mjs",
    "check:shared-parity": "node scripts/check-shared-parity.mjs",
    "check:mcp-cli-gate": "node scripts/check-mcp-cli-gate.mjs",
    "check:incomplete-reply": "node scripts/check-incomplete-reply.mjs",
    "check:workspace-write-yaml": "node scripts/check-workspace-write-yaml.mjs",
    "check:workspace-write-no-guess": "node scripts/check-workspace-write-no-guess.mjs",
    "check:cursor-parity-e2e": "node scripts/check-cursor-parity-e2e.mjs",
    "check:cli-bash-echo": "node scripts/check-cli-bash-echo.mjs",
    "check:turn-write-close": "node scripts/check-turn-write-close.mjs",
    "check:web-tsc": "node scripts/check-web-tsc.mjs",
    "check:ui-smoke": "node scripts/check-ui-smoke.mjs",
    "check:markdown-enabled": "node scripts/check-markdown-enabled.mjs",
    "check:eslint-hot": "node scripts/check-eslint-hot.mjs",
    "check:ui-playwright": "PLAYWRIGHT_BROWSERS_PATH=\"${PLAYWRIGHT_BROWSERS_PATH:-$PWD/.playwright-browsers}\" node scripts/check-ui-playwright.mjs",
    "check:ui-playwright:ci": "CHECK_UI_PLAYWRIGHT=1 PLAYWRIGHT_BROWSERS_PATH=\"${PLAYWRIGHT_BROWSERS_PATH:-$PWD/.playwright-browsers}\" node scripts/check-ui-playwright.mjs",
    "check:sticky-prompt": "node scripts/check-sticky-prompt.mjs",
    "check:dev-gates": "node scripts/check-turn-policy.mjs && node scripts/check-general-agent-route.mjs && node scripts/check-workspace-fidelity.mjs && node scripts/check-context-compact.mjs && node scripts/check-model-route.mjs && node scripts/check-shared-parity.mjs && node scripts/check-mcp-cli-gate.mjs && node scripts/check-incomplete-reply.mjs && node scripts/check-workspace-write-yaml.mjs && node scripts/check-workspace-write-no-guess.mjs && node scripts/check-turn-write-close.mjs && node scripts/check-cli-bash-echo.mjs && node scripts/check-web-tsc.mjs && node scripts/check-markdown-enabled.mjs && node scripts/check-ui-smoke.mjs && node scripts/check-eslint-hot.mjs && node scripts/check-sticky-prompt.mjs && node scripts/check-cursor-parity-e2e.mjs && node scripts/check-agent-adapters.mjs && node scripts/check-model-capability-cache.mjs && node scripts/check-tool-call-protocol.mjs && node scripts/check-stream-parsers.mjs && node scripts/check-host-retry-cancel.mjs && node scripts/check-explicit-agent-cancel.mjs && node scripts/check-workspace-command-cancel.mjs && node scripts/check-host-ollama-history-recovery.mjs && node scripts/check-host-prewrite-progress.mjs && node scripts/check-host-auto-continue.mjs && node scripts/check-host-read-pagination.mjs && node scripts/check-host-verification-closure.mjs && node scripts/check-edit-engine.mjs && node scripts/check-host-mcp-runtime.mjs && node scripts/check-host-edit-fallback.mjs && node scripts/check-host-file-tools.mjs && node scripts/check-workspace-test-detection.mjs && node scripts/check-turn-observability.mjs && node scripts/check-repository-map.mjs && npm run check:diff-hunks && node scripts/check-agent-guardrails.mjs && npm run check:agent-retry-actions && npm run check:project-rules && node scripts/check-ollama-stream-lossless.mjs && node scripts/eval-agent-suite.mjs --dry-run && npm run check:ui-playwright"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "playwright": "^1.61.1",
    "pyright": "^1.1.414",
    "ws": "^8.18.3"
  }
}

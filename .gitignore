.DS_Store

.claudecode/
.tmp/

# 用户本地配置（模型设置、偏好、密钥等）
.claude/settings.json
.codex/config.toml

# Dependencies & vendored bundles (install locally; do not push)
node_modules/
server/vendor/

# Web UI (chatter-page-polish)
web/node_modules/
web/dist/
web/dist-electron/
web/.env
web/.wrangler/
web/.tanstack/

# 数据库与备份
*.db
*.sqlite
*.bak

# Desktop packaging (build locally; do not push)
desktop/node_modules/
desktop/release/
desktop/out/

# graphify — knowledge graph cache and transient artifacts
graphify-out/cache/
graphify-out/cost.json
graphify-out/*.html
graphify-out/*.svg
graphify-out/obsidian/
graphify-out/snapshots/
graphify-out/branches/
graphify-out/node-status.json
graphify-out/.chain_writes.log
# .graphify_root 包含本地绝对路径
graphify-out/.graphify_root
# 临时提取脚本
graphify-out/.tmp_*.py

# TypeScript incremental build info
*.tsbuildinfo

# 根目录环境文件
.env
.env.local
